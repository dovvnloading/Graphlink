{
  "$defs": {
    "AdapterDescriptor": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "ports": {
          "$ref": "#/$defs/PortSet"
        },
        "side_effect_class": {
          "$ref": "#/$defs/SideEffectClass"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "ports",
        "side_effect_class"
      ],
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "media_type",
        "filename",
        "size_bytes"
      ],
      "type": "object"
    },
    "FileValue": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "kind": {
          "enum": [
            "file"
          ]
        }
      },
      "required": [
        "kind",
        "asset"
      ],
      "type": "object"
    },
    "ImageValue": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "kind": {
          "enum": [
            "image"
          ]
        }
      },
      "required": [
        "kind",
        "asset"
      ],
      "type": "object"
    },
    "InputBinding": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      },
      "required": [
        "port",
        "source"
      ],
      "type": "object"
    },
    "InputSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowInputSource"
        },
        {
          "$ref": "#/$defs/StepOutputSource"
        }
      ]
    },
    "JsonData": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonData"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonData"
          },
          "type": "object"
        }
      ]
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "json"
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonData"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "PortKind": {
      "enum": [
        "text",
        "json",
        "table",
        "file",
        "image"
      ]
    },
    "PortSet": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PortKind"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "required"
      ],
      "type": "object"
    },
    "PortValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextValue"
        },
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "$ref": "#/$defs/TableValue"
        },
        {
          "$ref": "#/$defs/FileValue"
        },
        {
          "$ref": "#/$defs/ImageValue"
        }
      ]
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "SideEffectClass": {
      "enum": [
        "pure",
        "local-read",
        "cloud",
        "executes",
        "writes"
      ]
    },
    "StepOutputSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "step"
          ]
        },
        "port": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step_id",
        "port"
      ],
      "type": "object"
    },
    "TableValue": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "table"
          ]
        },
        "rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/JsonScalar"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "TextValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "WorkflowInputSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "input"
          ]
        },
        "port": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "port"
      ],
      "type": "object"
    },
    "WorkflowOutput": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "$ref": "#/$defs/PortSpec"
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      },
      "required": [
        "port",
        "source"
      ],
      "type": "object"
    },
    "WorkflowRunRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/PortValue"
          },
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/PortValue"
          },
          "type": "object"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "spec": {
          "$ref": "#/$defs/WorkflowSpec"
        },
        "spec_fingerprint": {
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "spec",
        "spec_fingerprint",
        "status",
        "created_at",
        "started_at",
        "finished_at",
        "inputs",
        "outputs",
        "error"
      ],
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/WorkflowOutput"
          },
          "type": "array"
        },
        "revision": {
          "type": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/WorkflowStepSpec"
          },
          "type": "array"
        },
        "workflow_id": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workflow_id",
        "revision",
        "name",
        "inputs",
        "steps",
        "outputs"
      ],
      "type": "object"
    },
    "WorkflowStepSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterDescriptor"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/InputBinding"
          },
          "type": "array"
        },
        "config_json": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "adapter",
        "config_json",
        "bindings"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/WorkflowRunRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowRunRecord"
}
